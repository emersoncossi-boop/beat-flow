'use client';

import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { CheckCircle2, ChevronRight, Check, Sparkles, UploadCloud, Copy, ArrowRight, Home } from 'lucide-react';
import Link from 'next/link';
import Image from 'next/image';

const steps = [
  { id: 1, title: 'Identidade' },
  { id: 2, title: 'Sonoridade' },
  { id: 3, title: 'Rider Técnico' },
  { id: 4, title: 'Biografia' },
  { id: 5, title: 'Sucesso' }
];

const genreOptions = [
  'Tech House', 'Melodic Techno', 'House', 'Techno', 'Deep House', 
  'Progressive House', 'Trance', 'Open Format', 'Afro House', 
  'Drum & Bass', 'Funk', 'Eletrônica'
];

const equipmentCatalog = [
  { id: 'cdj3000', name: 'Pioneer CDJ-3000', img: 'https://images.unsplash.com/photo-1598508499971-2621740d5885?q=80&w=200&auto=format&fit=crop' },
  { id: 'djma9', name: 'Mixer DJM-A9', img: 'https://images.unsplash.com/photo-1601058269786-8d657fbcf3da?q=80&w=200&auto=format&fit=crop' },
  { id: 'technics', name: 'Toca-Discos Technics', img: 'https://images.unsplash.com/photo-1603513220556-91e779aef70e?q=80&w=200&auto=format&fit=crop' },
  { id: 'xone96', name: 'Allen & Heath Xone:96', img: 'https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?q=80&w=200&auto=format&fit=crop' },
  { id: 'monitors', name: 'Monitores de Alta Potência', img: 'https://images.unsplash.com/photo-1545167622-3a6ac756afa4?q=80&w=200&auto=format&fit=crop' },
];

export default function OnboardingPage() {
  const [currentStep, setCurrentStep] = useState(1);
  const [isGeneratingBio, setIsGeneratingBio] = useState(false);

  const [formData, setFormData] = useState({
    artisticName: '',
    city: '',
    slug: '',
    soundcloudUrl: '',
    genres: [] as string[],
    equipment: {} as Record<string, number>,
    bioNotes: '',
    generatedBio: ''
  });

  const isSlugAvailable = formData.slug.length > 3 && /^[a-z0-9-]+$/.test(formData.slug);

  const handleNext = () => setCurrentStep(prev => Math.min(prev + 1, 5));
  const handleBack = () => setCurrentStep(prev => Math.max(prev - 1, 1));

  const toggleGenre = (genre: string) => {
    setFormData(prev => ({
      ...prev,
      genres: prev.genres.includes(genre)
        ? prev.genres.filter(g => g !== genre)
        : [...prev.genres, genre]
    }));
  };

  const handleEquipmentChange = (id: string, increment: number) => {
    setFormData(prev => {
      const currentVal = prev.equipment[id] || 0;
      const newVal = Math.max(0, currentVal + increment);
      
      const newEq = { ...prev.equipment };
      if (newVal === 0) {
        delete newEq[id];
      } else {
        newEq[id] = newVal;
      }
      
      return { ...prev, equipment: newEq };
    });
  };

  const generateAI = () => {
    setIsGeneratingBio(true);
    setTimeout(() => {
      setFormData(prev => ({
        ...prev,
        generatedBio: `Com uma base sólida construída em ${prev.city || 'anos de experiência'}, ${prev.artisticName || 'o artista'} se consolidou na cena eletrônica entregando sets marcantes de ${prev.genres.join(', ') || 'alta energia'}. Focado em groove e construções hipnóticas, suas apresentações são conhecidas por manter a pista conectada do início ao fim.`
      }));
      setIsGeneratingBio(false);
    }, 2000);
  };

  return (
    <div className="min-h-screen bg-[#08080F] text-white flex flex-col font-sans selection:bg-[#8A3FFC] selection:text-white relative overflow-hidden">
      {/* Background ambient lighting */}
      <div className="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-[#8A3FFC]/10 blur-[120px] pointer-events-none" />
      <div className="absolute bottom-[-20%] right-[-10%] w-[50%] h-[50%] rounded-full bg-[#00D1FF]/10 blur-[120px] pointer-events-none" />

      {/* Stepper (Hidden on step 5) */}
      {currentStep < 5 && (
        <div className="w-full max-w-2xl mx-auto px-6 pt-10 z-10">
          <div className="flex items-center justify-between relative">
            <div className="absolute left-0 top-1/2 -translate-y-1/2 w-full h-[2px] bg-white/5 z-0" />
            <div 
              className="absolute left-0 top-1/2 -translate-y-1/2 h-[2px] bg-gradient-to-r from-[#8A3FFC] to-[#00D1FF] z-0 transition-all duration-500 ease-out" 
              style={{ width: `${((currentStep - 1) / (4 - 1)) * 100}%` }}
            />
            
            {steps.slice(0, 4).map((step, idx) => (
              <div key={step.id} className="relative z-10 flex flex-col items-center gap-2">
                <div className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition-all duration-300 ${
                  currentStep > step.id 
                    ? 'bg-[#8A3FFC] text-white shadow-[0_0_15px_rgba(138,63,252,0.5)]' 
                    : currentStep === step.id 
                      ? 'bg-[#151226] text-white border-2 border-[#8A3FFC]' 
                      : 'bg-[#0F0D1C] text-white/40 border border-white/10'
                }`}>
                  {currentStep > step.id ? <Check className="w-4 h-4" /> : step.id}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Main Content Area */}
      <div className="flex-1 flex flex-col items-center justify-center w-full max-w-2xl mx-auto px-6 py-12 relative z-10">
        <AnimatePresence mode="wait">
          {/* STEP 1: IDENTITY */}
          {currentStep === 1 && (
            <motion.div 
              key="step1"
              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -20 }} transition={{ duration: 0.3 }}
              className="w-full flex flex-col gap-6"
            >
              <div className="text-center mb-4">
                <h1 className="text-3xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-white/70">
                  Garanta seu espaço na cena.
                </h1>
                <p className="text-white/50 text-sm mt-2">Personalize a sua URL exclusiva e defina como os contratantes encontrarão você.</p>
              </div>

              <div className="space-y-5 p-6 md:p-8 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-xl shadow-2xl">
                <div>
                  <label className="text-[11px] font-bold text-white/60 uppercase tracking-wider mb-2 block">
                    Nome Artístico
                  </label>
                  <input 
                    type="text" 
                    placeholder="Ex: Luna Martins"
                    value={formData.artisticName}
                    onChange={e => setFormData({...formData, artisticName: e.target.value})}
                    className="w-full h-12 bg-black/40 border border-white/10 rounded-xl px-4 text-white focus:outline-none focus:border-[#8A3FFC] transition-colors placeholder:text-white/20 font-medium"
                  />
                </div>

                <div>
                  <label className="text-[11px] font-bold text-white/60 uppercase tracking-wider mb-2 block">
                    Sua Link Exclusivo (URL)
                  </label>
                  <div className={`flex items-center h-12 bg-black/40 border rounded-xl overflow-hidden transition-colors ${
                    isSlugAvailable && formData.slug ? 'border-[#00D1FF]' : 'border-white/10 focus-within:border-[#8A3FFC]'
                  }`}>
                    <span className="pl-4 pr-2 text-white/40 font-mono text-sm select-none">beatflow.art/</span>
                    <input 
                      type="text" 
                      placeholder="luna-martins"
                      value={formData.slug}
                      onChange={e => setFormData({...formData, slug: e.target.value.toLowerCase().replace(/\s+/g, '-')})}
                      className="flex-1 h-full bg-transparent text-white font-mono text-sm focus:outline-none placeholder:text-white/20"
                    />
                    {isSlugAvailable && formData.slug && (
                      <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} className="pr-4">
                        <CheckCircle2 className="w-5 h-5 text-[#00D1FF]" />
                      </motion.div>
                    )}
                  </div>
                </div>

                <div>
                  <label className="text-[11px] font-bold text-white/60 uppercase tracking-wider mb-2 block">
                    Cidade Base
                  </label>
                  <input 
                    type="text" 
                    placeholder="Ex: São Paulo - SP"
                    value={formData.city}
                    onChange={e => setFormData({...formData, city: e.target.value})}
                    className="w-full h-12 bg-black/40 border border-white/10 rounded-xl px-4 text-white focus:outline-none focus:border-[#8A3FFC] transition-colors placeholder:text-white/20 font-medium"
                  />
                </div>
              </div>

              <div className="flex justify-end mt-4">
                <button 
                  onClick={handleNext}
                  disabled={!formData.artisticName || !formData.slug}
                  className="h-12 px-8 rounded-xl bg-gradient-to-r from-[#8A3FFC] to-[#00D1FF] text-white font-bold tracking-wide hover:shadow-[0_0_25px_rgba(138,63,252,0.4)] transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
                >
                  Continuar <ChevronRight className="w-5 h-5" />
                </button>
              </div>
            </motion.div>
          )}

          {/* STEP 2: SOUND */}
          {currentStep === 2 && (
            <motion.div 
              key="step2"
              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -20 }} transition={{ duration: 0.3 }}
              className="w-full flex flex-col gap-6"
            >
              <div className="text-center mb-4">
                <h1 className="text-3xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-white/70">
                  Qual é a sua vibe?
                </h1>
                <p className="text-white/50 text-sm mt-2">Conecte seu som para que os contratantes sintam a energia da sua pista.</p>
              </div>

              <div className="space-y-6 p-6 md:p-8 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-xl shadow-2xl">
                {/* Import AI */}
                <div className="p-4 rounded-2xl bg-black/40 border border-white/5 space-y-3">
                  <label className="text-[11px] font-bold text-white/60 uppercase tracking-wider block">
                    URL do Perfil no SoundCloud
                  </label>
                  <div className="flex flex-col sm:flex-row gap-2">
                    <input 
                      type="url" 
                      placeholder="https://soundcloud.com/luna-martins"
                      value={formData.soundcloudUrl}
                      onChange={e => setFormData({...formData, soundcloudUrl: e.target.value})}
                      className="flex-1 h-11 bg-white/5 border border-white/10 rounded-xl px-4 text-white text-sm focus:outline-none focus:border-[#8A3FFC] transition-colors placeholder:text-white/20"
                    />
                    <button className="h-11 px-5 rounded-xl bg-white/10 hover:bg-white/15 border border-white/10 text-white text-xs font-bold transition flex items-center justify-center gap-1.5 shrink-0">
                      <UploadCloud className="w-4 h-4 text-[#00D1FF]" />
                      Importar Dados <Sparkles className="w-3.5 h-3.5 text-amber-400" />
                    </button>
                  </div>
                </div>

                {/* Genre Cloud */}
                <div>
                  <label className="text-[11px] font-bold text-white/60 uppercase tracking-wider mb-3 block">
                    Selecione suas Vertentes Principais (Manual)
                  </label>
                  <div className="flex flex-wrap gap-2.5">
                    {genreOptions.map(genre => {
                      const isSelected = formData.genres.includes(genre);
                      return (
                        <button
                          key={genre}
                          onClick={() => toggleGenre(genre)}
                          className={`px-4 py-2 rounded-full text-xs font-bold transition-all duration-300 border ${
                            isSelected 
                              ? 'bg-[#8A3FFC]/20 border-[#8A3FFC] text-white shadow-[0_0_15px_rgba(138,63,252,0.3)]' 
                              : 'bg-white/5 border-white/10 text-white/60 hover:bg-white/10 hover:text-white'
                          }`}
                        >
                          {genre}
                        </button>
                      );
                    })}
                  </div>
                </div>
              </div>

              <div className="flex justify-between mt-4">
                <button 
                  onClick={handleBack}
                  className="h-12 px-6 rounded-xl bg-white/5 border border-white/10 text-white font-bold hover:bg-white/10 transition-colors"
                >
                  Voltar
                </button>
                <button 
                  onClick={handleNext}
                  className="h-12 px-8 rounded-xl bg-gradient-to-r from-[#8A3FFC] to-[#00D1FF] text-white font-bold tracking-wide hover:shadow-[0_0_25px_rgba(138,63,252,0.4)] transition-all flex items-center gap-2"
                >
                  Continuar <ChevronRight className="w-5 h-5" />
                </button>
              </div>
            </motion.div>
          )}

          {/* STEP 3: RIDER TÉCNICO */}
          {currentStep === 3 && (
            <motion.div 
              key="step3"
              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -20 }} transition={{ duration: 0.3 }}
              className="w-full flex flex-col gap-6"
            >
              <div className="text-center mb-4">
                <h1 className="text-3xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-white/70">
                  O que não pode faltar na sua cabine?
                </h1>
                <p className="text-white/50 text-sm mt-2">Monte seu Rider Técnico com poucos cliques. Sem necessidade de digitar.</p>
              </div>

              <div className="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 p-4 md:p-6 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-xl shadow-2xl">
                {equipmentCatalog.map(eq => {
                  const qty = formData.equipment[eq.id] || 0;
                  const isSelected = qty > 0;

                  return (
                    <div 
                      key={eq.id}
                      onClick={() => !isSelected && handleEquipmentChange(eq.id, 1)}
                      className={`relative flex flex-col items-center justify-between p-3 rounded-2xl border transition-all duration-300 cursor-pointer overflow-hidden ${
                        isSelected 
                          ? 'bg-[#151226]/80 border-[#00D1FF] shadow-[0_0_20px_rgba(0,209,255,0.15)]' 
                          : 'bg-black/40 border-white/10 hover:border-white/30'
                      }`}
                    >
                      <div className="w-16 h-16 mb-3 rounded-xl overflow-hidden opacity-80">
                        <Image 
                          src={eq.img} 
                          alt={eq.name} 
                          width={64} 
                          height={64} 
                          className="w-full h-full object-cover grayscale mix-blend-lighten" 
                          referrerPolicy="no-referrer"
                        />
                      </div>
                      
                      <div className="text-center w-full z-10 mb-2">
                        <div className="text-[11px] font-bold text-white leading-tight">{eq.name}</div>
                      </div>

                      {isSelected && (
                        <div className="w-full flex items-center justify-between bg-black/60 rounded-lg p-1 border border-white/10 z-10">
                          <button 
                            onClick={(e) => { e.stopPropagation(); handleEquipmentChange(eq.id, -1); }}
                            className="w-6 h-6 flex items-center justify-center bg-white/10 rounded-md hover:bg-white/20 text-white font-mono"
                          >-</button>
                          <span className="text-xs font-bold font-mono text-[#00D1FF]">{qty}x</span>
                          <button 
                            onClick={(e) => { e.stopPropagation(); handleEquipmentChange(eq.id, 1); }}
                            className="w-6 h-6 flex items-center justify-center bg-white/10 rounded-md hover:bg-white/20 text-white font-mono"
                          >+</button>
                        </div>
                      )}
                      
                      {!isSelected && (
                        <div className="w-full h-8 flex items-center justify-center bg-white/5 rounded-lg border border-white/5 text-[10px] font-bold text-white/50 uppercase">
                          Adicionar
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>

              <div className="flex justify-between mt-4">
                <button 
                  onClick={handleBack}
                  className="h-12 px-6 rounded-xl bg-white/5 border border-white/10 text-white font-bold hover:bg-white/10 transition-colors"
                >
                  Voltar
                </button>
                <button 
                  onClick={handleNext}
                  className="h-12 px-8 rounded-xl bg-gradient-to-r from-[#8A3FFC] to-[#00D1FF] text-white font-bold tracking-wide hover:shadow-[0_0_25px_rgba(138,63,252,0.4)] transition-all flex items-center gap-2"
                >
                  Continuar <ChevronRight className="w-5 h-5" />
                </button>
              </div>
            </motion.div>
          )}

          {/* STEP 4: BIO */}
          {currentStep === 4 && (
            <motion.div 
              key="step4"
              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -20 }} transition={{ duration: 0.3 }}
              className="w-full flex flex-col gap-6"
            >
              <div className="text-center mb-4">
                <h1 className="text-3xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white to-white/70">
                  Conte sua história (nós ajudamos com o resto).
                </h1>
                <p className="text-white/50 text-sm mt-2">Insira tópicos curtos (ex: Toco há 5 anos, já toquei no Club High).</p>
              </div>

              <div className="p-6 md:p-8 rounded-3xl bg-white/5 border border-white/10 backdrop-blur-xl shadow-2xl relative">
                
                {!formData.generatedBio ? (
                  <div className="relative">
                    <textarea 
                      placeholder="• Toco há 7 anos...&#10;• Foco em batidas fortes...&#10;• Já abri pista pro Vintage Culture..."
                      value={formData.bioNotes}
                      onChange={e => setFormData({...formData, bioNotes: e.target.value})}
                      className="w-full h-48 bg-black/40 border border-white/10 rounded-2xl p-5 text-white focus:outline-none focus:border-[#8A3FFC] transition-colors placeholder:text-white/20 resize-none font-medium leading-relaxed"
                    />
                    
                    <button 
                      onClick={generateAI}
                      disabled={isGeneratingBio}
                      className="absolute bottom-4 right-4 h-10 px-4 rounded-xl bg-[#8A3FFC] text-white text-xs font-bold tracking-wide hover:bg-[#722EE6] hover:shadow-[0_0_20px_rgba(138,63,252,0.5)] transition-all flex items-center gap-2 disabled:opacity-70"
                    >
                      {isGeneratingBio ? (
                        <>
                          <div className="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin" />
                          Gerando...
                        </>
                      ) : (
                        <>
                          Gerar Bio Profissional <Sparkles className="w-4 h-4 text-amber-300" />
                        </>
                      )}
                    </button>
                  </div>
                ) : (
                  <div className="relative">
                    <div className="absolute -top-3 left-4 px-2 py-0.5 bg-[#8A3FFC] text-white text-[10px] font-bold uppercase rounded-md flex items-center gap-1 shadow-lg z-10">
                      <Sparkles className="w-3 h-3 text-amber-300" /> Gerado por Inteligência Nexora
                    </div>
                    <textarea 
                      value={formData.generatedBio}
                      onChange={e => setFormData({...formData, generatedBio: e.target.value})}
                      className="w-full h-48 bg-[#151226]/50 border border-[#8A3FFC]/50 rounded-2xl p-5 pt-7 text-white focus:outline-none focus:border-[#00D1FF] transition-colors resize-none font-medium leading-relaxed"
                    />
                    <div className="flex justify-end gap-2 mt-3">
                      <button 
                        onClick={() => setFormData({...formData, generatedBio: ''})}
                        className="text-xs text-white/50 hover:text-white transition font-medium"
                      >
                        Descartar e refazer
                      </button>
                    </div>
                  </div>
                )}
              </div>

              <div className="flex justify-between mt-4">
                <button 
                  onClick={handleBack}
                  className="h-12 px-6 rounded-xl bg-white/5 border border-white/10 text-white font-bold hover:bg-white/10 transition-colors"
                >
                  Voltar
                </button>
                <button 
                  onClick={handleNext}
                  className="h-12 px-8 rounded-xl bg-gradient-to-r from-[#8A3FFC] to-[#00D1FF] text-white font-bold tracking-wide hover:shadow-[0_0_25px_rgba(138,63,252,0.4)] transition-all flex items-center gap-2"
                >
                  Concluir Perfil <CheckCircle2 className="w-5 h-5" />
                </button>
              </div>
            </motion.div>
          )}

          {/* STEP 5: SUCCESS (AHA! MOMENT) */}
          {currentStep === 5 && (
            <motion.div 
              key="step5"
              initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} transition={{ duration: 0.5, ease: "easeOut" }}
              className="w-full flex flex-col items-center gap-8"
            >
              <div className="text-center relative">
                {/* Simulated minimal confetti / glow */}
                <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-[#00D1FF]/20 blur-[80px] rounded-full z-0 pointer-events-none" />
                
                <h1 className="text-4xl md:text-5xl font-black tracking-tighter text-white relative z-10 flex items-center justify-center gap-3">
                  Seu Press Kit está no ar! <span className="text-4xl">🎉</span>
                </h1>
                <p className="text-white/60 text-base mt-3 max-w-md mx-auto relative z-10">
                  Sua identidade no Beat Flow foi criada. Compartilhe o link no seu Instagram e comece a fechar bookings profissionais.
                </p>
              </div>

              {/* iPhone Mockup Skeleton */}
              <div className="relative w-[280px] h-[580px] bg-black border-[6px] border-zinc-800 rounded-[40px] shadow-[0_0_50px_rgba(0,0,0,0.8)] overflow-hidden flex flex-col">
                <div className="absolute top-0 inset-x-0 h-6 bg-transparent flex justify-center z-20">
                  <div className="w-32 h-6 bg-zinc-800 rounded-b-3xl" />
                </div>
                
                {/* Screen Content */}
                <div className="flex-1 bg-[#08080F] relative overflow-hidden flex flex-col">
                  {/* Hero Image */}
                  <div className="h-40 bg-zinc-900 relative">
                    <div className="absolute inset-0 bg-gradient-to-t from-[#08080F] to-transparent z-10" />
                    <div className="absolute bottom-4 left-4 z-20">
                      <div className="w-14 h-14 rounded-full bg-zinc-800 border-2 border-[#08080F] mb-2" />
                      <div className="h-4 w-24 bg-white/90 rounded mb-1" />
                      <div className="h-2 w-16 bg-[#00D1FF] rounded" />
                    </div>
                  </div>

                  {/* Body Content */}
                  <div className="flex-1 p-4 flex flex-col gap-3">
                    {/* CTA */}
                    <div className="h-10 w-full bg-[#8A3FFC] rounded-xl" />
                    
                    {/* Player */}
                    <div className="h-20 w-full bg-white/5 border border-white/10 rounded-xl" />
                    
                    {/* Rider */}
                    <div className="h-24 w-full bg-white/5 border border-white/10 rounded-xl grid grid-cols-2 gap-2 p-2">
                      <div className="bg-white/5 rounded-lg" />
                      <div className="bg-white/5 rounded-lg" />
                    </div>
                  </div>
                </div>
              </div>

              {/* Final Actions */}
              <div className="flex flex-col items-center gap-4 w-full max-w-sm mt-4">
                <button 
                  className="w-full h-14 rounded-2xl bg-gradient-to-r from-[#8A3FFC] to-[#00D1FF] text-white text-lg font-black tracking-wide hover:shadow-[0_0_30px_rgba(0,209,255,0.4)] hover:scale-[1.02] transition-all flex items-center justify-center gap-2"
                >
                  <Copy className="w-5 h-5" />
                  Copiar Link para a Bio
                </button>
                
                <Link href="/dashboard" className="w-full h-12 flex items-center justify-center gap-2 rounded-xl text-white/50 font-bold hover:text-white hover:bg-white/5 transition-colors">
                  Ir para o Dashboard de Gestão <ArrowRight className="w-4 h-4" />
                </Link>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    </div>
  );
}
