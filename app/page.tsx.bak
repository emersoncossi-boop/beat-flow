                >
                  {/* Subtle Neon Light-Leak Effect (CSS Radial Gradient simulating light interacting with the background assets) */}
                  <div 
                    className="absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500 ease-out z-0 mix-blend-screen"
                    style={{
                      background: style.leakGradient
                    }}
                  />

                  {/* Corner Atmospheric Neon Prismatic Flare */}
                  <div 
                    className="absolute -top-10 -right-10 w-44 h-44 rounded-full pointer-events-none opacity-0 group-hover:opacity-60 blur-2xl transition-all duration-500 ease-out transform group-hover:scale-125 z-0"
                    style={{
                      background: style.leakGlow
                    }}
                  />

                  {/* Top ambient highlight line */}
