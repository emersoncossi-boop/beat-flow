  return (
    <div className="min-h-screen bg-[#08080F] text-white selection:bg-[#8A3FFC] selection:text-white relative overflow-x-hidden font-sans">
      
      {/* Dynamic Atmospheric Canvas (Filmic Stage Haze, Lasers, Volumetric Meshes) */}
      <AtmosphericCanvas />

      {/* Main Sticky Header (Height 88px to 96px, dark transparent with subtle blur) */}
      <header className="h-[88px] sm:h-[96px] border-b border-white/[0.08] bg-[#08080F]/85 backdrop-blur-xl sticky top-0 z-40 px-5 sm:px-8 md:px-12 lg:px-16 transition-all">
        <div className="max-w-[1440px] mx-auto h-full flex items-center justify-between">
          
          {/* Official Beat Flow Logo */}
          <div className="flex items-center gap-12">
            <Logo size="md" />

            {/* Desktop Navigation Menu */}
            <nav className="hidden lg:flex items-center gap-8 text-sm font-medium text-[rgba(255,255,255,0.72)]">
              <Link href="/explorar" className="hover:text-white transition-colors">
                Artistas
              </Link>
              <a href="#tudo-em-um-so-lugar" className="hover:text-white transition-colors">
                Eventos
              </a>
              <a href="#como-funciona" className="hover:text-white transition-colors">
                Oportunidades
              </a>
              <a href="#para-quem-e" className="hover:text-white transition-colors">
                Preços
              </a>
              <Link href="/explorar" className="hover:text-white transition-colors">
                Blog
              </Link>
            </nav>
          </div>

          {/* Right Action CTAs */}
          <div className="hidden sm:flex items-center gap-3.5">
            <Link href="/login">
              <button className="text-sm font-medium text-white px-5 py-2 rounded-xl border border-white/20 bg-white/5 hover:bg-white/10 hover:border-white/40 transition-all cursor-pointer">
                Entrar
              </button>
            </Link>

            <Link href="/login?mode=signup">
              <button className="h-10 sm:h-11 px-6 rounded-xl bg-gradient-to-r from-[#7C3AED] via-[#8A3FFC] to-[#9333EA] hover:opacity-95 text-white text-sm font-bold shadow-[0_0_22px_rgba(138,63,252,0.6)] hover:shadow-[0_0_34px_rgba(138,63,252,0.9)] transition-all flex items-center justify-center cursor-pointer">
                <span>Criar meu perfil</span>
              </button>
            </Link>
          </div>

          {/* Mobile Hamburger Menu Toggle */}
          <div className="flex sm:hidden items-center gap-3">
            <Link href="/login?mode=signup">
              <button className="px-3.5 py-1.5 rounded-full bg-[#8A3FFC] text-white text-xs font-bold shadow-md">
                Criar perfil
              </button>
            </Link>
            <button 
              onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}
              className="p-2 text-white hover:bg-white/10 rounded-lg transition"
              aria-label="Abrir Menu"
            >
              {isMobileMenuOpen ? <X className="w-6 h-6" /> : <Menu className="w-6 h-6" />}
            </button>
          </div>

        </div>

        {/* Mobile Dropdown Menu */}
        {isMobileMenuOpen && (
          <div className="sm:hidden absolute top-[80px] left-0 w-full bg-[#0d0c1a] border-b border-white/10 p-6 flex flex-col gap-4 shadow-2xl animate-in slide-in-from-top-2">
            <Link href="/explorar" onClick={() => setIsMobileMenuOpen(false)} className="text-sm font-medium text-white py-2">
              Artistas
            </Link>
            <a href="#tudo-em-um-so-lugar" onClick={() => setIsMobileMenuOpen(false)} className="text-sm font-medium text-white py-2">
              Eventos
            </a>
            <a href="#como-funciona" onClick={() => setIsMobileMenuOpen(false)} className="text-sm font-medium text-white py-2">
              Oportunidades
            </a>
            <a href="#para-quem-e" onClick={() => setIsMobileMenuOpen(false)} className="text-sm font-medium text-white py-2">
              Preços
            </a>
            <div className="pt-4 border-t border-white/10 flex flex-col gap-3">
              <Link href="/login" onClick={() => setIsMobileMenuOpen(false)}>
                <button className="w-full py-2.5 rounded-xl border border-white/15 text-white text-sm font-medium">
                  Entrar
                </button>
              </Link>
              <Link href="/login?mode=signup" onClick={() => setIsMobileMenuOpen(false)}>
                <button className="w-full py-3 rounded-xl bg-gradient-to-r from-[#7C3AED] via-[#8A3FFC] to-[#00D1FF] text-white text-sm font-bold shadow-lg shadow-[#8A3FFC]/40">
                  Criar meu perfil gratuito
                </button>
              </Link>
            </div>
          </div>
        )}

        <LuminousDivider glow={false} className="absolute bottom-0 left-0 right-0" />
      </header>

      {/* ---------------------------------------------------- */}
      {/* HERO SECTION (FULL SCREEN CINEMATIC — 100% BF ASSET FIDELITY) */}
      {/* ---------------------------------------------------- */}
      <section className="relative min-h-[92vh] lg:min-h-[890px] w-full flex items-center pt-16 sm:pt-20 lg:pt-24 pb-16 sm:pb-20 overflow-hidden bg-[#080B0F]">
        
        {/* Production Background Graphic Assets Layer: BF_background-deep-flow.svg & BF_background-aurora.svg */}
        <div className="absolute inset-0 z-0 pointer-events-none overflow-hidden select-none">
          {/* Deep Flow Base Layer */}
          <div className="absolute inset-0 opacity-45 mix-blend-screen">
            <Image 
              src="/assets/beatflow/BF_background-deep-flow.svg" 
              alt="Beat Flow Deep Flow Background" 
              fill 
              className="object-cover object-center" 
              priority 
            />
          </div>

          {/* Aurora Glow Atmosphere Layer */}
          <div className="absolute inset-0 opacity-35 mix-blend-screen">
            <Image 
              src="/assets/beatflow/BF_background-aurora.svg" 
              alt="Beat Flow Aurora Atmosphere" 
              fill 
              className="object-cover object-center" 
              priority 
            />
          </div>

          {/* Real DJ on Stage in Arena */}
          <Image 
            src="/assets/landing/hero-dj-stage.jpg"
            alt="DJ no palco"
            fill
            priority
            className="object-cover object-center lg:object-[66%_26%] opacity-55 sm:opacity-70 lg:opacity-85 scale-105"
          />

          {/* Production Asset: BF_graphic-glow-orb.svg behind Left Column */}
          <div className="absolute -top-16 -left-16 w-[560px] h-[560px] pointer-events-none -z-10 opacity-70">
            <Image 
              src="/assets/beatflow/BF_graphic-glow-orb.svg" 
              alt="" 
              width={560} 
              height={560} 
              className="w-full h-full object-contain" 
            />
          </div>

          {/* Production Asset: BF_graphic-glow-orb.svg behind Stage DJ & Player */}
          <div className="absolute top-1/4 right-[4%] w-[520px] h-[520px] pointer-events-none -z-10 opacity-60">
            <Image 
              src="/assets/beatflow/BF_graphic-glow-orb.svg" 
              alt="" 
              width={520} 
              height={520} 
              className="w-full h-full object-contain" 
            />
          </div>

          {/* Theme Vignette Gradients (Dark left for high text legibility, clear center-right for DJ and stage) */}
          <div className="absolute inset-0 bg-gradient-to-r from-[#080B0F] via-[#080B0F]/90 via-40% to-transparent" />
          <div className="absolute inset-0 bg-gradient-to-t from-[#080B0F] via-[#080B0F]/20 to-transparent" />
        </div>

        {/* Volumetric Stage Spotlight Beam cutting from stage rig down towards the DJ */}
        <div 
          className="hidden lg:block absolute -top-16 left-[74%] xl:left-[76%] -translate-x-1/2 w-[480px] h-[780px] pointer-events-none opacity-40 mix-blend-screen z-0"
          style={{
            background: 'conic-gradient(from 180deg at 50% 0%, transparent 162deg, rgba(138,63,252,0.25) 174deg, rgba(0,209,255,0.32) 180deg, rgba(255,77,219,0.25) 186deg, transparent 198deg)',
            filter: 'blur(32px)',
          }}
        />

        {/* Subtle Ambient Light Motes drifting in the stage beam */}
        <div className="hidden lg:block absolute top-[24%] left-[72%] xl:left-[75%] -translate-x-1/2 w-[280px] h-[320px] pointer-events-none z-10 opacity-70">
          <div className="w-1.5 h-1.5 rounded-full bg-[#00D1FF] shadow-[0_0_12px_#00D1FF] absolute top-10 left-12 animate-pulse" />
          <div className="w-2 h-2 rounded-full bg-[#C084FC] shadow-[0_0_15px_#C084FC] absolute top-28 right-8 animate-ping opacity-60" style={{ animationDuration: '4s' }} />
          <div className="w-1 h-1 rounded-full bg-white shadow-[0_0_8px_white] absolute bottom-16 left-24 animate-pulse" />
        </div>

        {/* 3D Motion Neon Halo Ring — 100% Fidelity to BF_graphic-halo-ring.svg */}
        <div className="hidden lg:block absolute top-[18%] xl:top-[20%] left-[74%] xl:left-[76%] -translate-x-1/2 w-[340px] h-[160px] pointer-events-none z-10">
          <motion.div
            animate={{
              y: [0, -8, 0],
              rotateX: [68, 71, 68],
              rotateZ: [-6, -4, -6],
              scale: [1, 1.03, 1]
            }}
            transition={{
              duration: 5,
              repeat: Infinity,
              ease: "easeInOut"
            }}
            className="relative w-full h-full flex items-center justify-center"
            style={{ perspective: 800, transformStyle: "preserve-3d" }}
          >
            {/* Ambient radial flare */}
            <div className="absolute inset-0 bg-gradient-to-r from-[#FF4DB8]/35 via-[#8A3FFC]/45 to-[#00D1FF]/35 blur-[45px] rounded-full scale-125" />
            
            {/* Exact SVG definition from BF_graphic-halo-ring.svg */}
            <svg viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg" className="w-[280px] h-[280px] drop-shadow-[0_0_35px_rgba(255,77,184,0.85)]">
              <defs>
                <filter id="heroHaloGlow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="8" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
                <linearGradient id="heroHaloGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stopColor="#00D1FF" />
                  <stop offset="50%" stopColor="#8A3FFC" />
                  <stop offset="100%" stopColor="#FF4DB8" />
                </linearGradient>
              </defs>
              <circle cx="128" cy="128" r="96" stroke="url(#heroHaloGrad)" strokeWidth="12" filter="url(#heroHaloGlow)" opacity="0.95" />
              <circle cx="128" cy="128" r="96" stroke="#FFFFFF" strokeWidth="2.5" opacity="0.85" />
              {/* Internal stage illumination disc */}
              <circle cx="128" cy="128" r="88" fill="url(#heroHaloGrad)" opacity="0.14" />
            </svg>
          </motion.div>
        </div>

        <div className="max-w-[1440px] w-full mx-auto px-5 sm:px-8 md:px-12 lg:px-16 relative z-10 flex flex-col lg:flex-row items-center justify-between gap-10">
          
          {/* Left Column: Text, CTAs, Waveform, Stats, Logos */}
          <div className="w-full lg:w-[56%] flex flex-col justify-center text-left pt-6 sm:pt-10 lg:pt-0">
            {/* Eyebrow Label & Live Stage Badge */}
            <div className="mb-4 sm:mb-6 flex flex-wrap items-center gap-3 justify-center lg:justify-start">
              <span className="text-[12px] sm:text-[14px] lg:text-[15px] font-bold tracking-[0.24em] text-[var(--bf-text-secondary,#A7ADC0)] uppercase flex items-center gap-2">
                <span className="w-2 h-2 rounded-full bg-[#00D1FF] shadow-[0_0_8px_#00D1FF] animate-pulse" />
                PRESS KIT OFICIAL PARA DJS
              </span>
            </div>

            {/* Headline with 100% BF_tokens Gradient Flow */}
            <h1 className="text-[42px] sm:text-[56px] lg:text-[68px] xl:text-[80px] font-black tracking-[-0.04em] text-white leading-[1.02] mb-6 text-center lg:text-left">
              Seu som abre a porta.<br />
              O Beat Flow transforma interesse em{' '}
