          <div className="flex md:grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 overflow-x-auto md:overflow-visible pb-8 md:pb-0 snap-x snap-mandatory hide-scrollbar -mx-5 px-5 sm:mx-0 sm:px-0">
            {djSegments.map((segment, i) => {
              const segmentStyles = [
                {
                  borderHover: "hover:border-[#8A3FFC]",
                  shadowHover: "hover:shadow-[0_25px_50px_rgba(138,63,252,0.25)]",
                  lineGlow: "group-hover:via-[#8A3FFC]",
                  badgeColor: "text-[#C084FC] bg-[#8A3FFC]/15 border-[#8A3FFC]/30",
                  dotColor: "bg-[#8A3FFC]",
                  tagText: "CDJ-3000 / DJM-A9",
                  leakClass: "bf-light-leak-purple",
                  leakGlow: "rgba(138, 63, 252, 0.45)",
                  leakGradient: "radial-gradient(550px circle at 85% 12%, rgba(138, 63, 252, 0.28), rgba(168, 85, 247, 0.12) 36%, transparent 72%), radial-gradient(350px circle at 15% 90%, rgba(0, 209, 255, 0.14), transparent 65%)"
                },
                {
                  borderHover: "hover:border-[#00D1FF]",
                  shadowHover: "hover:shadow-[0_25px_50px_rgba(0,209,255,0.25)]",
                  lineGlow: "group-hover:via-[#00D1FF]",
                  badgeColor: "text-[#00D1FF] bg-[#00D1FF]/15 border-[#00D1FF]/30",
                  dotColor: "bg-[#00D1FF]",
                  tagText: "PREMIUM PA / WIRELESS",
                  leakClass: "bf-light-leak-cyan",
                  leakGlow: "rgba(0, 209, 255, 0.45)",
                  leakGradient: "radial-gradient(550px circle at 85% 12%, rgba(0, 209, 255, 0.28), rgba(0, 102, 255, 0.12) 36%, transparent 72%), radial-gradient(350px circle at 15% 90%, rgba(138, 63, 252, 0.14), transparent 65%)"
                },
                {
                  borderHover: "hover:border-[#FF4DB8]",
                  shadowHover: "hover:shadow-[0_25px_50px_rgba(255,77,184,0.25)]",
                  lineGlow: "group-hover:via-[#FF4DB8]",
                  badgeColor: "text-[#FF4DB8] bg-[#FF4DB8]/15 border-[#FF4DB8]/30",
                  dotColor: "bg-[#FF4DB8]",
                  tagText: "SYNTHS / LIVE ACT",
                  leakClass: "bf-light-leak-pink",
                  leakGlow: "rgba(255, 77, 184, 0.45)",
                  leakGradient: "radial-gradient(550px circle at 85% 12%, rgba(255, 77, 184, 0.28), rgba(138, 63, 252, 0.12) 36%, transparent 72%), radial-gradient(350px circle at 15% 90%, rgba(0, 209, 255, 0.14), transparent 65%)"
                }
              ];
              const style = segmentStyles[i % segmentStyles.length];

              return (
                <motion.div 
                  key={i}
                  whileHover={{ y: -8, scale: 1.02 }}
                  transition={{ duration: 0.3 }}
                  onClick={() => setSelectedDetailSegment(segment)}
