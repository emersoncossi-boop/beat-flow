rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "admin@beatflow.me" ||
        request.auth.token.role == "superadmin" ||
        request.auth.token.admin == true
      );
    }

    // 1. User / DJ Profile (Public read for discovery, owner write, admin all)
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isSuperAdmin', 'subscriptionPlan'])) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();

      match /profile/{docId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }

      match /tracks/{trackId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }

      match /tourDates/{dateId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Proposals / Bookings (Contractor create, Owner & Contractor read, Owner update status)
    match /proposals/{proposalId} {
      allow create: if true; // Public contractors can submit booking proposals
      allow read: if isAuthenticated() && (resource.data.djId == request.auth.uid || resource.data.contractorUid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.djId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Subscriptions & Payments (Strict: Admin & System only write)
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 4. Admin Audit Logs & Analytics
    match /admin_metrics/{docId} {
      allow read, write: if isAdmin();
    }

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}